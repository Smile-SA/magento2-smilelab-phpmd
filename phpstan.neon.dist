parameters:
    level: 6
    paths:
        - src
    checkMissingIterableValueType: false
    checkGenericClassInNonGenericObjectType: false
    ignoreErrors:
        -
            # Only needed with phpmd 2.x (the methods exist in phpmd 3)
            message: '#Call to an undefined method PHPMD\\Node\\ClassNode::#'
            reportUnmatched: false
